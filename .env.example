# ---------------------------------------------------------------------------
# Copiloto da Reforma — variaveis de ambiente
# Copie para .env e preencha. NUNCA comite o .env.
# ---------------------------------------------------------------------------

NODE_ENV=desenvolvimento          # desenvolvimento | teste | producao
PORT=3000

# --- Banco de dados ---------------------------------------------------------
DATABASE_URL=postgres://copiloto:senha@localhost:5432/copiloto
DB_POOL_MAX=10

# --- Fila -------------------------------------------------------------------
# Sem REDIS_URL a fila roda em modo inline (mesmo processo). Serve para
# desenvolvimento e testes; em producao e obrigatorio.
REDIS_URL=
FILA_CONCORRENCIA=5

# --- Seguranca (secao 8) ----------------------------------------------------
# Chave de 32 bytes para cifrar dados_entrada e resultado em repouso.
# Gere com: openssl rand -base64 32
# Obrigatoria em producao — sem ela o servidor recusa subir.
CHAVE_CRIPTOGRAFIA=

# Politica de retencao dos dados fiscais de terceiros.
RETENCAO_ARQUIVOS_DIAS=90
RETENCAO_DADOS_ENTRADA_DIAS=365

# --- Armazenamento ----------------------------------------------------------
ARMAZENAMENTO_DRIVER=local        # local | s3
ARMAZENAMENTO_DIR=./armazenamento-local
S3_BUCKET=
AWS_REGION=sa-east-1

# --- WhatsApp (DisparaIA) ---------------------------------------------------
# Sem DISPARAIA_URL as mensagens vao para o log em vez de serem enviadas.
DISPARAIA_URL=
DISPARAIA_TOKEN=
# Segredo compartilhado que assina o webhook de entrada (HMAC-SHA256).
# Obrigatorio em producao.
DISPARAIA_WEBHOOK_SECRET=

# --- Motor de simulacao (secao 6) -------------------------------------------
# ATENCAO: so mude para true DEPOIS que um contador ou tributarista revisar
# as regras de calculo. Ver docs/VALIDACAO-FISCAL.md.
# Enquanto for false: confianca sempre 'baixa', laudo carimbado como
# provisorio, e simular em producao retorna 503.
MOTOR_VALIDADO=false
MOTOR_VALIDADO_POR=
